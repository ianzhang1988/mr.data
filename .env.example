# LLM 配置（OpenAI 兼容接口）
MR_DATA_LLM_BASE_URL=https://api.openai.com/v1
MR_DATA_LLM_API_KEY=your_api_key_here
MR_DATA_LLM_MODEL=gpt-4o-mini
# 结构化输出模式：auto（parse 失败后自动降级）/ parse（仅原生解析）/ prompt（仅 schema-in-prompt）
# MR_DATA_LLM_STRUCTURED_MODE=auto

# PostgreSQL DSN。优先级：显式 DSN > pgembed。
# 留空且 MR_DATA_USE_PGEMBED=true 时使用嵌入式 PostgreSQL；
# 若 USE_PGEMBED=false 且未设 DSN 会运行时报错。
# MR_DATA_POSTGRES_DSN=postgresql://user:password@localhost:5432/mrdata

# 数据根目录（默认锚定项目根：<项目根>/data，与运行目录无关）。
# 注意：显式设置的相对路径仍相对当前工作目录（CWD）。
# MR_DATA_DATA_DIR=/path/to/data

# pgembed 嵌入式 PostgreSQL（未配置外部 DSN 时的默认方式）
# 默认 <data_dir>/pgembed
MR_DATA_USE_PGEMBED=true
# MR_DATA_PGEMBED_DATA_DIR=./data/pgembed

# Chroma 持久化目录（默认 <data_dir>/chroma）
# MR_DATA_CHROMA_PERSIST_DIR=./data/chroma

# 人格文件配置（默认 <data_dir>/personalities/data.json）
# MR_DATA_PERSONALITY_FILE=./data/personalities/data.json

# 向量库 embedding 配置
# MR_DATA_PERSONALITY_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# MR_DATA_PERSONALITY_EMBEDDING_DIM=512
# MR_DATA_MEMORY_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
# MR_DATA_MEMORY_EMBEDDING_DIM=768
# MR_DATA_CHROMA_RECREATE_ON_MISMATCH=true

# 日志配置（JSONL，滚动保留；log_dir 默认 <项目根>/logs）
# MR_DATA_LOG_DIR=./logs
MR_DATA_LOG_LEVEL=INFO
MR_DATA_LOG_MAX_BYTES=10000000
MR_DATA_LOG_BACKUP_COUNT=5
MR_DATA_LOG_TO_STDOUT=true

# 网络搜索 RAG（默认开启）
MR_DATA_ENABLE_WEB_SEARCH=true
MR_DATA_WEB_SEARCH_MAX_RESULTS=3
# 搜索 Provider 及尝试顺序（前一个失败时按顺序降级）；
# 可选值：duckduckgo / searxng / brave / bing / google_cse / baidu / qihoo360
# MR_DATA_WEB_SEARCH_PROVIDERS=["duckduckgo"]
# 各 Provider 所需的地址 / 密钥（仅启用对应 Provider 时需要）
# MR_DATA_SEARXNG_BASE_URL=
# MR_DATA_BRAVE_API_KEY=
# MR_DATA_BING_API_KEY=
# MR_DATA_GOOGLE_API_KEY=
# MR_DATA_GOOGLE_CSE_ID=
# 网页正文提取
MR_DATA_ENABLE_WEB_DOC_EXTRACTION=true
MR_DATA_WEB_EXTRACT_MAX_PAGES=2
MR_DATA_WEB_EXTRACT_MAX_LENGTH=4000

# 离线归因配置
MR_DATA_OFFLINE_BATCH_SIZE=50
MR_DATA_OFFLINE_LOOKBACK_DAYS=7
MR_DATA_OFFLINE_MAX_SESSION_LOGS=100
# 单会话归因落库的最大 delta 条数
# MR_DATA_OFFLINE_MAX_DELTAS_PER_SESSION=3
# 新建性格维度前的 LLM 重合判断（防维度膨胀）
# MR_DATA_ENABLE_DIMENSION_DEDUP=true
MR_DATA_PERSONALITY_RETRIEVAL_TOP_K=5
MR_DATA_FAILURE_THRESHOLD=5

# 对话记忆配置
# 对话记录保留天数
# MR_DATA_MEMORY_DIALOGUE_RETENTION_DAYS=90
# 记忆被检索命中的最低次数门槛
# MR_DATA_MEMORY_MIN_RECALL_COUNT=1
# 记忆检索返回条数
# MR_DATA_MEMORY_RETRIEVAL_TOP_K=5
# 记忆检索的 LLM 相关性过滤（默认关闭）
# MR_DATA_ENABLE_MEMORY_RELEVANCE_FILTER=false
# 离线写入记忆向量库的分段：每段字符预算 / 段间重叠行数
# MR_DATA_MEMORY_DIALOGUE_CHUNK_CHARS=1200
# MR_DATA_MEMORY_DIALOGUE_CHUNK_OVERLAP_LINES=2

# 对话行为配置
# 是否在 CLI 回复后显示参考来源（也可用 mr-data chat --show-references 临时开启）
# MR_DATA_SHOW_REFERENCES=false
# DialogueState 中保留的最近对话轮数
# MR_DATA_DIALOGUE_STATE_MESSAGE_TURNS=10

# token 预算配置
# LLM 上下文 tokenizer（tiktoken 编码名）
# MR_DATA_TOKENIZER_MODEL=cl100k_base
# LLM 上下文 token 上限
# MR_DATA_LLM_CONTEXT_TOKEN_LIMIT=30000
